#!/usr/bin/env bash
# Play an audio file. Uses afplay on macOS, mpg123 on Linux.
# Usage: play [-v <volume>] <file>
#   -v  Volume as a float 0.0–1.0 (default: 1.0)

set -e

volume="1.0"

while [[ $# -gt 0 ]]; do
    case "$1" in
        -v) volume="$2"; shift 2 ;;
        *)  break ;;
    esac
done

if [[ $# -eq 0 ]]; then
    echo "Usage: play [-v <volume>] <file>" >&2
    exit 1
fi

if [[ "$(uname)" == "Darwin" ]]; then
    exec afplay -v "$volume" "$@"
else
    # mpg123 --scale range is 0–32768 (default 32768 = full volume)
    scale=$(printf '%.0f' "$(echo "$volume * 32768" | bc)")
    # -o pulse,alsa are the first two backends mpg123 would try anyway. The rest
    # of its default chain ends in portaudio, and trying portaudio after the alsa
    # backend has failed segfaults, dropping a core file in the current
    # directory. ulimit -c 0 suppresses the core if it crashes anyway.
    ulimit -c 0
    exec mpg123 -o pulse,alsa --quiet --scale "$scale" "$@"
fi
