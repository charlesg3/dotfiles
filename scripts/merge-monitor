#!/usr/bin/env python3
"""Watch one GitLab MR through review, merge, and the pipeline of the merged
commit. Print one line when something changes, so that a Monitor task can
react to it.

Requires an authenticated glab. With no --project, the project comes from
the origin remote of the current directory.
"""
import argparse
import html
import json
import re
import subprocess
import sys
import time
from pathlib import Path

# After the merge, how long to wait for GitLab to create the push pipeline
# before falling back to the merge train pipeline.
POST_GRACE_SECONDS = 600

# Short-lived mergeability states. Reporting them would only add noise.
TRANSIENT_MERGE_STATUSES = {"checking", "unchecked", "preparing"}

# System notes worth reacting to. Labels, assignees, title edits, review
# requests and "mentioned in" notes are left out.
SYSTEM_NOTE_PATTERNS = (
    r"approved this merge request",
    r"unapproved this merge request",
    r"reset approvals",
    r"added \d+ commit",
    r"force-pushed",
    r"marked this merge request as \*{0,2}(?:draft|ready)",
    r"resolved all threads",
    r"changed target branch",
    r"enabled an automatic merge",
    r"aborted the automatic merge",
    r"canceled the automatic merge",
    r"enabled automatic add to merge train",
    r"(?:cancelled|canceled|aborted) automatic add to merge train",
    r"removed this merge request from the merge train",
)
ACTIONABLE_SYSTEM_NOTE_RE = re.compile(rf"^(?:{'|'.join(SYSTEM_NOTE_PATTERNS)})", re.IGNORECASE)


def glab(path, raw=False, must_exist=False):
    """Call `glab api`. Return parsed JSON (or text when raw), or None on a
    failure, so that the next poll tries again. With must_exist, a 404 ends
    the script, so that it does not poll forever against nothing."""
    result = subprocess.run(["glab", "api", path], capture_output=True, text=True)
    if result.returncode != 0:
        if must_exist and "404" in result.stderr:
            sys.exit(f"{path} not found")
        return None
    if raw:
        return result.stdout
    try:
        return json.loads(result.stdout)
    except ValueError:
        return None


def project_path_from_origin():
    """Return group/name from the origin remote, or exit."""
    result = subprocess.run(["git", "remote", "get-url", "origin"], capture_output=True, text=True)
    url = result.stdout.strip().removesuffix(".git")
    if "://" in url:
        return url.split("://", 1)[1].split("/", 1)[1]
    if ":" in url:
        return url.rsplit(":", 1)[1]
    sys.exit("no --project given and there is no origin remote here")


def resolve_project_id(project):
    """Return a numeric project id. Some proxies return 404 for the encoded
    slash in projects/group%2Fname, so look a path up by search instead."""
    if project.isdigit():
        return project
    name = project.rsplit("/", 1)[-1]
    for p in glab(f"projects?search={name}&membership=true&per_page=100") or []:
        if p.get("path_with_namespace", "").lower() == project.lower():
            return str(p["id"])
    sys.exit(f"could not resolve project id for {project}")


class MergeMonitor:
    def __init__(self, project_id, mr_iid, watch_image):
        self.project_id = project_id
        self.mr_iid = mr_iid
        self.watch_image_re = re.compile(watch_image) if watch_image else None
        # Own comments come back on the next poll. Skip them, but keep own
        # system notes, such as a push that resets approvals.
        self.username = (glab("user") or {}).get("username", "")
        # State lives on disk, so a restarted monitor continues without
        # repeating events.
        self.state_file = Path(f"/tmp/merge_monitor_{project_id}_{mr_iid}.json")
        try:
            self.state = json.loads(self.state_file.read_text())
        except (OSError, ValueError):
            self.state = {}

    def project_api(self, path="", **kwargs):
        """`glab api` for this project, or for a path under it."""
        return glab(f"projects/{self.project_id}" + (f"/{path}" if path else ""), **kwargs)

    def mr_api(self, path="", **kwargs):
        """`glab api` for this MR, or for a path under it."""
        return self.project_api(f"merge_requests/{self.mr_iid}" + (f"/{path}" if path else ""), **kwargs)

    def save(self):
        tmp = self.state_file.with_suffix(".tmp")
        tmp.write_text(json.dumps(self.state))
        tmp.replace(self.state_file)

    def report_transition(self, key, value, event, suppress=()):
        """Record value under key, and print "event old -> new" when it
        changed. The first value seen is recorded without a report. Values
        in suppress are not recorded, so the next change is reported from
        the last value that was."""
        previous = self.state.get(key)
        if value == previous or value in suppress:
            return
        self.state[key] = value
        if previous:
            print(f"{event} {previous} -> {value}")

    def record_if_new(self, key, item):
        """Record item under key and return whether it was new."""
        seen = self.state.setdefault(key, [])
        if item in seen:
            return False
        seen.append(item)
        return True

    def jobs(self, pipeline_id, scope):
        return self.project_api(f"pipelines/{pipeline_id}/jobs?per_page=100&scope[]={scope}") or []

    def failed_job_events(self, pipeline_id, seen_key, event_name):
        for job in self.jobs(pipeline_id, "failed"):
            if self.record_if_new(seen_key, job["id"]):
                yield (f"{event_name} {job['id']}|{job['name']}|"
                       f"allow_failure={job['allow_failure']}|{job['web_url']}")

    def image_ready_events(self, pipeline_id):
        """Successful manifest-* jobs that match --watch-image, with the image
        tag they published, so testing can start before the pipeline ends."""
        if not self.watch_image_re:
            return
        for job in self.jobs(pipeline_id, "success"):
            name = job["name"]
            if not name.startswith("manifest-") or not self.watch_image_re.search(name):
                continue
            if job["id"] in self.state.get("image_job_ids", []):
                continue
            # The tag appears only in the job log. Tag schemes differ, but
            # each tag holds the short sha of the commit. Take the last one
            # printed, without the per-architecture variants. If the log
            # cannot be read, try again on the next poll.
            trace = self.project_api(f"jobs/{job['id']}/trace", raw=True)
            if trace is None:
                continue
            self.record_if_new("image_job_ids", job["id"])
            trace = re.sub(r"\x1b\[[0-9;]*m", "", trace)
            short_sha = re.escape(job["commit"]["short_id"])
            tags = re.findall(rf":([A-Za-z0-9._-]*{short_sha}[A-Za-z0-9._-]*)", trace)
            tags = [t for t in tags if not re.search(r"-(amd64|arm64)$", t)]
            yield f"[image-ready] {name} {tags[-1] if tags else 'unknown'}"

    def note_events(self):
        # Request newest notes first so pagination cannot hide newer activity.
        notes = self.mr_api("notes?sort=desc&order_by=created_at&per_page=100") or []
        last_note_id = self.state.get("last_note_id", 0)
        for note in sorted(notes, key=lambda n: n["id"]):
            if note["id"] <= last_note_id:
                continue
            self.state["last_note_id"] = note["id"]
            author = (note.get("author") or {}).get("username", "")
            # System notes carry HTML. Drop the tags and fold to one line.
            body = re.sub(r"<[^>]+>", " ", note.get("body") or "")
            body = html.unescape(body)
            body = " ".join(body.split())[:400]
            if note.get("system"):
                if ACTIONABLE_SYSTEM_NOTE_RE.match(body):
                    yield f"[system-note] {author}: {body}"
            elif author != self.username:
                yield f"[note] {author}: {body}"

    def poll_pre_merge(self):
        """Watch the MR itself. Return True when the watch is over."""
        mr = self.mr_api(must_exist=True)
        if mr is None:
            return False
        target_branch = mr["target_branch"]

        if mr["state"] == "closed":
            print(f"[closed] MR !{self.mr_iid} was closed")
            return True
        if mr["state"] == "merged":
            merge_sha = mr.get("merge_commit_sha") or mr.get("squash_commit_sha") or mr["sha"]
            project = self.project_api()
            if project is None:
                return False
            # Other branches have no push pipeline for the merged commit, so
            # there is nothing to follow.
            if target_branch != project["default_branch"]:
                print(f"[merged] {merge_sha} (target {target_branch}: no push pipeline, not watching post-merge)")
                return True
            print(f"[merged] {merge_sha}")
            self.state.update(merge_sha=merge_sha, target_branch=target_branch)
            return False

        head_pipeline = mr.get("head_pipeline") or {}
        pipeline_status = head_pipeline.get("status") or "none"
        merge_status = mr.get("detailed_merge_status") or ""
        self.report_transition("mr_pipeline_status", pipeline_status, "[pipeline]")
        # A merge train runs its own pipeline, not the head pipeline, so a
        # change in mergeability is the only sign that the train dropped the MR.
        self.report_transition("merge_status", merge_status, "[merge-status]",
                               suppress=TRANSIENT_MERGE_STATUSES)

        if head_pipeline.get("id"):
            for event in self.failed_job_events(head_pipeline["id"], "mr_failed_job_ids", "[job-failed]"):
                print(event)
            for event in self.image_ready_events(head_pipeline["id"]):
                print(event)
        for event in self.note_events():
            print(event)

        # GitLab's mergeable status includes approvals and resolved
        # discussions. Tie readiness to the head commit, so that a fix pushed
        # after a failed merge is reported as ready again.
        is_ready_to_merge = (pipeline_status == "success" and merge_status == "mergeable"
                             and not mr.get("has_conflicts") and not mr.get("draft"))
        if is_ready_to_merge and self.state.get("ready_sha") != mr["sha"]:
            print("[ready-to-merge] pipeline green, approved, discussions resolved, no conflicts")
            self.state["ready_sha"] = mr["sha"]
        elif merge_status != "mergeable" and merge_status not in TRANSIENT_MERGE_STATUSES:
            self.state["ready_sha"] = None
        return False

    def poll_post_merge(self):
        """Follow the push pipeline of the merged commit on the target branch.
        Return True when the watch is over."""
        merge_sha = self.state["merge_sha"]
        pipelines = self.project_api(f"pipelines?sha={merge_sha}&per_page=20")
        if not isinstance(pipelines, list):
            # A failed read says nothing about the pipelines. Try again.
            return False
        # Scheduled and manual pipelines run fewer jobs, so only a push
        # pipeline shows that the merged commit built.
        push_pipeline = max((p for p in pipelines
                             if p["ref"] == self.state["target_branch"] and p["source"] == "push"),
                            key=lambda p: p["id"], default=None)

        if push_pipeline is None:
            # GitLab normally creates the push pipeline within seconds. After
            # the grace period, accept a green merge train pipeline, which
            # tested the merged result, or give up.
            started_at = self.state.setdefault("post_merge_started_at", time.time())
            if time.time() - started_at < POST_GRACE_SECONDS:
                return False
            train_pipeline = max((p for p in pipelines if p["ref"].endswith("/train")),
                                 key=lambda p: p["id"], default=None)
            if train_pipeline and train_pipeline["status"] == "success":
                print(f"[post-green] {merge_sha} (no push pipeline; "
                      f"train pipeline {train_pipeline['id']} tested the merged result)")
            else:
                print(f"[post-no-pipeline] {merge_sha} no push pipeline after "
                      f"{POST_GRACE_SECONDS}s and no green train pipeline")
            return True

        pipeline_status = push_pipeline["status"]
        self.report_transition("post_pipeline_status", pipeline_status, "[post-pipeline]")
        for event in self.failed_job_events(push_pipeline["id"], "post_failed_job_ids", "[post-job-failed]"):
            print(event)
        if pipeline_status == "success":
            print(f"[post-green] {merge_sha}")
            return True

        # Report a red pipeline once, and keep polling so a retry is seen.
        failure_status = pipeline_status if pipeline_status in ("failed", "canceled") else None
        if failure_status != self.state.get("post_failure_status"):
            self.state["post_failure_status"] = failure_status
            if failure_status:
                print(f"[post-failed] {merge_sha} pipeline {push_pipeline['id']} {failure_status}")
        return False

    def poll(self):
        if self.state.get("merge_sha"):
            return self.poll_post_merge()
        return self.poll_pre_merge()


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("mr", help="MR number, the digits after !")
    parser.add_argument("--project", help="project id or group/name (default: from the origin remote)")
    parser.add_argument("--poll", type=int, default=90, help="seconds between polls (default 90)")
    parser.add_argument("--watch-image", metavar="REGEX",
                        help="report successful manifest-* jobs whose name matches REGEX, with the image tag")
    args = parser.parse_args()

    # Each line must reach the Monitor as soon as it is printed.
    sys.stdout.reconfigure(line_buffering=True)
    project = args.project or project_path_from_origin()
    monitor = MergeMonitor(resolve_project_id(project), args.mr, args.watch_image)
    while True:
        done = monitor.poll()
        monitor.save()
        if done:
            return
        time.sleep(args.poll)


if __name__ == "__main__":
    main()
