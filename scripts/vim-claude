#!/usr/bin/env bash
# Opens nvim with a vertical split: editor on the left, Claude in a terminal on the right.
# The terminal runs claude without the shell function in shell/aliases.sh, so
# the flags are repeated here.
#
# Usage:
#   vim-claude [file ...]

exec nvim "$@" \
  -c "NvimTreeOpen" \
  -c "wincmd l" \
  -c "rightbelow vsplit | terminal claude --dangerously-skip-permissions --model claude-opus-5-5" \
  -c "startinsert"
