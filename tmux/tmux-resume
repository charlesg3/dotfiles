#!/usr/bin/env bash
# Resume a tmux session from saved configuration, or create a new one.
#
# Usage:
#   tmux-resume [session-name]     - Resume or create a session. With no name:
#                                    the session you are in, or main outside tmux
#   tmux-resume install            - Install hooks to Claude settings
#
# Looks for session config in the directory next to this script:
#   - If no session of that name exists, create it with those windows and run
#     the saved commands
#   - If one does exist, put back only the saved windows it is missing, then
#     attach. A session that exists is not a session that was restored: `t`
#     (tmux new-session -As main) and a bare `tmux` both make one out of
#     nothing, and a resume run into that has to fill it rather than bail
#   - If no config exists, just create an empty session
#
# Config format: win-<epoch>-<rand>.json in the sessions/ directory. The file
# name is opaque; .index is where the window sat and is what orders the restore.
#   {
#     "name": "tab-name",
#     "cwd": "/optional/working/directory",
#     "index": 3,
#     "window_id": "@2",          optional, and stale after a server restart
#     "server_pid": 5893,         optional, the server that handed out that id
#     "server_start": "...",      optional, when that server started
#     "command": "command to run" optional
#   }
#
# Every file here is restored. A window the user closed no longer has a file:
# tmux-sync-tabs deletes it at the point it is closed, which is the only point
# where a closed window can be told apart from a server that died.

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SESSIONS_DIR="${TMUX_SESSIONS_DIR:-$SCRIPT_DIR/sessions}"
# Store both absolute and tilde-expanded paths for hook command
CLAUDE_HOOK_ABS="$SCRIPT_DIR/claude-tmux-hook"
CLAUDE_HOOK_PATH="~/src/dotfiles/tmux/claude-tmux-hook"

# ============================================================================
# Install function - adds hooks to Claude settings
# ============================================================================
install_hooks() {
    CLAUDE_SETTINGS="$HOME/.claude/settings.json"

    if [ ! -f "$CLAUDE_SETTINGS" ]; then
        echo "Error: $CLAUDE_SETTINGS not found"
        echo "Please set up Claude Code first (run 'claude' to initialize)"
        return 1
    fi

    # Check if hook is already installed (check for either tilde or absolute path)
    if jq -e '.hooks.SessionStart[0].hooks[] | select(.command | contains("claude-tmux-hook"))' "$CLAUDE_SETTINGS" >/dev/null 2>&1; then
        echo "✓ Hook already installed in $CLAUDE_SETTINGS"
        return 0
    fi

    echo "Installing tmux-resume hook to $CLAUDE_SETTINGS..."

    # Create a backup
    cp "$CLAUDE_SETTINGS" "$CLAUDE_SETTINGS.backup"
    echo "  Backup created: $CLAUDE_SETTINGS.backup"

    # Add the hook to SessionStart hooks array if it doesn't already exist
    # This uses jq to safely add the hook object, preventing duplicates
    jq '.hooks.SessionStart[0].hooks |= if any(.command | contains("claude-tmux-hook")) then . else . + [{
        "type": "command",
        "command": "'"$CLAUDE_HOOK_PATH"'"
    }] end' "$CLAUDE_SETTINGS" > "$CLAUDE_SETTINGS.tmp"

    if [ $? -ne 0 ]; then
        echo "Error: Failed to add hook to settings"
        rm -f "$CLAUDE_SETTINGS.tmp"
        return 1
    fi

    mv "$CLAUDE_SETTINGS.tmp" "$CLAUDE_SETTINGS"
    echo "✓ Successfully installed tmux-resume hook"
    echo "  Hook will run on SessionStart to capture tmux tab state"
    echo ""
    echo "Next steps:"
    echo "  1. Start a new Claude session in a tmux window"
    echo "  2. The hook will automatically capture the tab configuration"
    echo "  3. Use 'tmux-resume' to restore the session later"
}

# With no argument: inside tmux, act on the session the caller is already in.
# Defaulting to "main" regardless meant running this from a session named
# anything else took the "no such session" path and built a second session
# alongside the live one, which reads as the resume having done nothing.
# Outside tmux there is no current session to read, so fall back to the name a
# restore creates.
if [ -n "${1:-}" ]; then
    SESSION_NAME="$1"
elif [ -n "${TMUX:-}" ]; then
    if [ -n "${TMUX_PANE:-}" ]; then
        SESSION_NAME=$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}' 2>/dev/null || true)
    else
        SESSION_NAME=$(tmux display-message -p '#{session_name}' 2>/dev/null || true)
    fi
    SESSION_NAME="${SESSION_NAME:-main}"
else
    SESSION_NAME="main"
fi

# Handle install command
if [ "$SESSION_NAME" = "install" ]; then
    install_hooks
    exit $?
fi

# Create sessions directory if it doesn't exist
mkdir -p "$SESSIONS_DIR"

# When a process started, as a string, rendered the way tmux-sync-tabs renders
# it. Pids are recycled, so a pid on its own can name two different servers.
proc_start_time() {
    local out
    case "$1" in '' | *[!0-9]*) return 1 ;; esac
    out=$(LC_ALL=C TZ=UTC ps -o lstart= -p "$1" 2>/dev/null) || return 1
    out=$(printf '%s' "$out" | tr -s ' ' | sed 's/^ *//; s/ *$//')
    [ -n "$out" ] || return 1
    printf '%s' "$out"
}

# Read the saved tabs, in .index order. The file name says nothing about where
# a window sat, so the order has to come from the field. Anything that is not a
# JSON object is skipped rather than restored as a blank window.
#
# This is read before the session is looked up, because a session that exists
# is not the same as a session that holds what was saved. `t` (new-session -As
# main) and a bare `tmux` both leave a session whose windows have nothing to do
# with these files, and treating that as "already restored" is what made a
# resume run right after login look like it did nothing at all.
TAB_INDEX=()
TAB_NAME=()
TAB_CWD=()
TAB_CMD=()
TAB_WID=()
TAB_SPID=()
TAB_SSTART=()

TAB_FILES=()
for f in "$SESSIONS_DIR"/win-*.json; do
    [ -f "$f" ] || continue
    TAB_FILES+=("$f")
done

if [ ${#TAB_FILES[@]} -gt 0 ] && command -v jq >/dev/null 2>&1; then
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        idx=${line%%$'\t'*}; line=${line#*$'\t'}
        nm=${line%%$'\t'*}; line=${line#*$'\t'}
        cw=${line%%$'\t'*}; line=${line#*$'\t'}
        cmd=${line%%$'\t'*}; line=${line#*$'\t'}
        wid=${line%%$'\t'*}; line=${line#*$'\t'}
        spid=${line%%$'\t'*}; sstart=${line#*$'\t'}
        TAB_INDEX+=("$idx")
        TAB_NAME+=("$nm")
        TAB_CWD+=("$cw")
        TAB_CMD+=("$cmd")
        TAB_WID+=("$wid")
        TAB_SPID+=("$spid")
        TAB_SSTART+=("$sstart")
    done < <(
        jq -rs '
            to_entries
            | map(select(.value | type == "object"))
            | sort_by([(.value.index // 1e9), .key])
            | .[].value
            | [(.index // 0 | tostring), (.name // "tab"), (.cwd // ""), (.command // ""),
               (.window_id // ""), (.server_pid // "" | tostring), (.server_start // "")]
            | @tsv' "${TAB_FILES[@]}" 2>/dev/null
    )
fi

# ── Placing one tab ───────────────────────────────────────────────────────────

# The live window at <index> of <session>, as "<id> <panes> <command>", or
# nothing when that index is free.
window_at() {
    tmux list-windows -t "$1" -F \
        '#{window_index} #{window_id} #{window_panes} #{pane_current_command}' 2>/dev/null |
        awk -v ix="$2" '$1 == ix { print $2, $3, $4; exit }'
}

# A single pane sitting at a shell prompt with nothing running in it. That is
# exactly what `t` leaves behind at the index the first saved tab wants, and
# reusing it is what keeps a restore from stranding an empty window beside the
# real one.
is_idle_window() {
    [ "$1" = "1" ] || return 1
    case "$2" in bash | zsh | sh | fish | dash | ksh) return 0 ;; esac
    return 1
}

# Put saved tab <i> into <session> and echo the window id it landed on. <after>
# is where to fall back to when the tab's own index is taken by a window that is
# busy: inserting after the previous window keeps the order and loses only the
# exact index, which beats dropping the window. <bound> is a live idle window
# the tab is already bound to, which is taken over wherever it sits rather than
# left orphaned beside a second window for the same tab.
place_tab() {
    local session=$1 i=$2 after=$3 bound=${4:-}
    local idx=${TAB_INDEX[$i]} name=${TAB_NAME[$i]} cwd=${TAB_CWD[$i]}
    local occ occ_id occ_panes occ_cmd wid args

    if [ -n "$bound" ]; then
        tmux rename-window -t "$bound" "$name" 2>/dev/null || true
        printf '%s' "$bound"
        return 0
    fi

    occ=$(window_at "$session" "$idx")
    if [ -n "$occ" ]; then
        read -r occ_id occ_panes occ_cmd <<< "$occ"
        if is_idle_window "$occ_panes" "$occ_cmd"; then
            tmux rename-window -t "$occ_id" "$name" 2>/dev/null || true
            # An existing shell's directory can only be changed by telling the
            # shell, so the cwd rides along with the command below rather than
            # being set here.
            printf '%s' "$occ_id"
            return 0
        fi
    fi

    args=(-d -P -F '#{window_id}' -n "$name")
    if [ -n "$cwd" ] && [ -d "$cwd" ]; then
        args+=(-c "$cwd")
    fi
    wid=$(tmux new-window "${args[@]}" -t "$session:$idx" 2>/dev/null) ||
        wid=$(tmux new-window "${args[@]}" -a -t "$after")
    printf '%s' "$wid"
}

# Send a tab's saved command to the window it was placed on. A window that was
# reused still has the shell's own directory, so it is moved first; a window
# that was created got -c and is already there.
run_tab() {
    local wid=$1 i=$2 reused=$3
    local cwd=${TAB_CWD[$i]} cmd=${TAB_CMD[$i]}
    if [ "$reused" = "1" ] && [ -n "$cwd" ] && [ -d "$cwd" ]; then
        cmd="cd $(printf '%q' "$cwd")${cmd:+ && $cmd}"
    fi
    [ -n "$cmd" ] || return 0
    tmux send-keys -t "$wid" "$cmd" Enter
}

# Attach, or switch when this is already running inside tmux: attaching to a
# session from a pane in that same session is an error, not a no-op.
enter_session() {
    if [ -n "${TMUX:-}" ]; then
        if [ "$(tmux display-message -p '#{session_name}' 2>/dev/null || true)" = "$1" ]; then
            return 0
        fi
        tmux switch-client -t "$1"
    else
        tmux attach-session -t "$1"
    fi
}

# ── An existing session: put back whatever is missing from it ─────────────────

if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    SERVER_PID=$(tmux display-message -p -t "$SESSION_NAME" '#{pid}' 2>/dev/null || true)
    SERVER_START=$(proc_start_time "$SERVER_PID") || SERVER_START=""
    LIVE_IDS=$(tmux list-windows -t "$SESSION_NAME" -F '#{window_id}' 2>/dev/null || true)

    # A tab is already up only when the window it names is live on the server
    # that named it *and* something is running in that window. Live-but-idle has
    # to count as missing: tmux-sync-tabs binds a file to a bare window as soon
    # as one appears at its index, so after `t` the first saved tab looks bound
    # while its shell has never run anything. Skipping it there is what would
    # leave the largest session sitting unrestored behind an empty prompt.
    #
    # The cost is that a restored window the user has since quit out of gets its
    # command run again. That is what asking for a resume means.
    MISSING=()
    MISSING_BOUND=()
    for i in "${!TAB_INDEX[@]}"; do
        bound=""
        if [ -n "${TAB_WID[$i]}" ] && [ -n "$SERVER_PID" ] &&
            [ "${TAB_SPID[$i]}" = "$SERVER_PID" ] &&
            [ "${TAB_SSTART[$i]}" = "$SERVER_START" ] &&
            printf '%s\n' "$LIVE_IDS" | grep -qxF -- "${TAB_WID[$i]}"; then
            state=$(tmux display-message -p -t "${TAB_WID[$i]}" \
                '#{window_panes} #{pane_current_command}' 2>/dev/null || true)
            read -r p_count p_cmd <<< "$state"
            if ! is_idle_window "$p_count" "$p_cmd"; then
                continue
            fi
            bound=${TAB_WID[$i]}
        fi
        MISSING+=("$i")
        MISSING_BOUND+=("$bound")
    done

    if [ ${#MISSING[@]} -gt 0 ]; then
        FILL_WID=()
        FILL_REUSED=()
        after=$(tmux list-windows -t "$SESSION_NAME" -F '#{window_id}' | head -1)
        for k in "${!MISSING[@]}"; do
            i=${MISSING[$k]}
            before=$(tmux list-windows -t "$SESSION_NAME" -F '#{window_id}' | wc -l)
            wid=$(place_tab "$SESSION_NAME" "$i" "$after" "${MISSING_BOUND[$k]}")
            now=$(tmux list-windows -t "$SESSION_NAME" -F '#{window_id}' | wc -l)
            FILL_WID+=("$wid")
            if [ "$now" -eq "$before" ]; then FILL_REUSED+=(1); else FILL_REUSED+=(0); fi
            after=$wid
        done

        # Bind the files to these windows before anything runs in them, for the
        # same reason the fresh-session path below does it.
        tmux run-shell "TMUX_SESSIONS_DIR=$(printf '%q' "$SESSIONS_DIR") $(printf '%q' "$SCRIPT_DIR/tmux-sync-tabs")" >/dev/null 2>&1 || true

        for k in "${!MISSING[@]}"; do
            run_tab "${FILL_WID[$k]}" "${MISSING[$k]}" "${FILL_REUSED[$k]}"
        done
    fi

    enter_session "$SESSION_NAME"
    exit 0
fi

# Create the session
if [ ${#TAB_INDEX[@]} -eq 0 ]; then
    # No config found, just create an empty session
    tmux new-session -d -s "$SESSION_NAME"
else
    # Put each window back at its saved index rather than packing them from the
    # base index. Gaps in the indices are normal (a window was closed), and
    # keeping them is what lets tmux-sync-tabs rebind these files by index after
    # a server restart, when every saved window id is stale.
    first_cwd="${TAB_CWD[0]}"
    if [ -n "$first_cwd" ] && [ -d "$first_cwd" ]; then
        tmux new-session -d -s "$SESSION_NAME" -n "${TAB_NAME[0]}" -c "$first_cwd"
    else
        tmux new-session -d -s "$SESSION_NAME" -n "${TAB_NAME[0]}"
    fi

    base_idx=$(tmux display-message -p -t "$SESSION_NAME" '#{window_index}')
    if [ "$base_idx" != "${TAB_INDEX[0]}" ]; then
        tmux move-window -s "$SESSION_NAME:$base_idx" -t "$SESSION_NAME:${TAB_INDEX[0]}" 2>/dev/null || true
    fi
    WIN_TARGET=("$(tmux display-message -p -t "$SESSION_NAME" '#{window_id}')")

    for i in "${!TAB_INDEX[@]}"; do
        [ "$i" -eq 0 ] && continue
        args=(-d -P -F '#{window_id}' -n "${TAB_NAME[$i]}")
        if [ -n "${TAB_CWD[$i]}" ] && [ -d "${TAB_CWD[$i]}" ]; then
            args+=(-c "${TAB_CWD[$i]}")
        fi
        # A saved index can be taken already if two sessions' files ended up in
        # one directory. Inserting after the previous window keeps the order and
        # loses only the exact index, which beats dropping the window.
        wid=$(tmux new-window "${args[@]}" -t "$SESSION_NAME:${TAB_INDEX[$i]}" 2>/dev/null) ||
            wid=$(tmux new-window "${args[@]}" -a -t "${WIN_TARGET[$((${#WIN_TARGET[@]} - 1))]}")
        WIN_TARGET+=("$wid")
    done

    # Bind the files to the windows that were just created, before anything
    # runs in them. The window ids and the server they came from are both new,
    # and until they are recorded every file still describes the dead server:
    # the Claude hook would find no file for the window it starts in and write
    # a second one, and the next reconcile would keep rebinding by index.
    # The hooks in tmux.conf fire on these windows too, but they can collide on
    # the lock and skip, so the one run that has to happen is done here.
    tmux run-shell "TMUX_SESSIONS_DIR=$(printf '%q' "$SESSIONS_DIR") $(printf '%q' "$SCRIPT_DIR/tmux-sync-tabs")" >/dev/null 2>&1 || true

    # Run the commands only once every window exists, and target windows by id:
    # an index can still shift while the session is being built.
    for i in "${!TAB_INDEX[@]}"; do
        if [ -n "${TAB_CMD[$i]}" ]; then
            tmux send-keys -t "${WIN_TARGET[$i]}" "${TAB_CMD[$i]}" Enter
        fi
    done
fi

# Attach to the session
enter_session "$SESSION_NAME"
