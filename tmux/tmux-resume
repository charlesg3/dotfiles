#!/usr/bin/env bash
# Resume a tmux session from saved configuration, or create a new one.
#
# Usage:
#   tmux-resume [session-name]     - Resume or create a session
#   tmux-resume install            - Install hooks to Claude settings
#
# Looks for session config in the directory next to this script:
#   - If a tmux session exists with the saved config, attach to it
#   - If not, create a new session with those windows/panes and run the saved commands
#   - If no config exists, just create an empty session
#
# Config format: win-<epoch>-<rand>.json in the sessions/ directory. The file
# name is opaque; .index is where the window sat and is what orders the restore.
#   {
#     "name": "tab-name",
#     "cwd": "/optional/working/directory",
#     "index": 3,
#     "window_id": "@2",          optional, and stale after a server restart
#     "server_pid": 5893,         optional, the server that handed out that id
#     "server_start": "...",      optional, when that server started
#     "command": "command to run" optional
#   }
#
# Every file here is restored. A window the user closed no longer has a file:
# tmux-sync-tabs deletes it at the point it is closed, which is the only point
# where a closed window can be told apart from a server that died.

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SESSIONS_DIR="${TMUX_SESSIONS_DIR:-$SCRIPT_DIR/sessions}"
# Store both absolute and tilde-expanded paths for hook command
CLAUDE_HOOK_ABS="$SCRIPT_DIR/claude-tmux-hook"
CLAUDE_HOOK_PATH="~/src/dotfiles/tmux/claude-tmux-hook"

# ============================================================================
# Install function - adds hooks to Claude settings
# ============================================================================
install_hooks() {
    CLAUDE_SETTINGS="$HOME/.claude/settings.json"

    if [ ! -f "$CLAUDE_SETTINGS" ]; then
        echo "Error: $CLAUDE_SETTINGS not found"
        echo "Please set up Claude Code first (run 'claude' to initialize)"
        return 1
    fi

    # Check if hook is already installed (check for either tilde or absolute path)
    if jq -e '.hooks.SessionStart[0].hooks[] | select(.command | contains("claude-tmux-hook"))' "$CLAUDE_SETTINGS" >/dev/null 2>&1; then
        echo "✓ Hook already installed in $CLAUDE_SETTINGS"
        return 0
    fi

    echo "Installing tmux-resume hook to $CLAUDE_SETTINGS..."

    # Create a backup
    cp "$CLAUDE_SETTINGS" "$CLAUDE_SETTINGS.backup"
    echo "  Backup created: $CLAUDE_SETTINGS.backup"

    # Add the hook to SessionStart hooks array if it doesn't already exist
    # This uses jq to safely add the hook object, preventing duplicates
    jq '.hooks.SessionStart[0].hooks |= if any(.command | contains("claude-tmux-hook")) then . else . + [{
        "type": "command",
        "command": "'"$CLAUDE_HOOK_PATH"'"
    }] end' "$CLAUDE_SETTINGS" > "$CLAUDE_SETTINGS.tmp"

    if [ $? -ne 0 ]; then
        echo "Error: Failed to add hook to settings"
        rm -f "$CLAUDE_SETTINGS.tmp"
        return 1
    fi

    mv "$CLAUDE_SETTINGS.tmp" "$CLAUDE_SETTINGS"
    echo "✓ Successfully installed tmux-resume hook"
    echo "  Hook will run on SessionStart to capture tmux tab state"
    echo ""
    echo "Next steps:"
    echo "  1. Start a new Claude session in a tmux window"
    echo "  2. The hook will automatically capture the tab configuration"
    echo "  3. Use 'tmux-resume' to restore the session later"
}

SESSION_NAME="${1:-main}"

# Handle install command
if [ "$SESSION_NAME" = "install" ]; then
    install_hooks
    exit $?
fi

# Create sessions directory if it doesn't exist
mkdir -p "$SESSIONS_DIR"

# Check if a session with this name already exists
if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    tmux attach-session -t "$SESSION_NAME"
    exit 0
fi

# Read the saved tabs, in .index order. The file name says nothing about where
# a window sat, so the order has to come from the field. Anything that is not a
# JSON object is skipped rather than restored as a blank window.
TAB_INDEX=()
TAB_NAME=()
TAB_CWD=()
TAB_CMD=()

TAB_FILES=()
for f in "$SESSIONS_DIR"/win-*.json; do
    [ -f "$f" ] || continue
    TAB_FILES+=("$f")
done

if [ ${#TAB_FILES[@]} -gt 0 ] && command -v jq >/dev/null 2>&1; then
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        idx=${line%%$'\t'*}; line=${line#*$'\t'}
        nm=${line%%$'\t'*}; line=${line#*$'\t'}
        cw=${line%%$'\t'*}; cmd=${line#*$'\t'}
        TAB_INDEX+=("$idx")
        TAB_NAME+=("$nm")
        TAB_CWD+=("$cw")
        TAB_CMD+=("$cmd")
    done < <(
        jq -rs '
            to_entries
            | map(select(.value | type == "object"))
            | sort_by([(.value.index // 1e9), .key])
            | .[].value
            | [(.index // 0 | tostring), (.name // "tab"), (.cwd // ""), (.command // "")]
            | @tsv' "${TAB_FILES[@]}" 2>/dev/null
    )
fi

# Create the session
if [ ${#TAB_INDEX[@]} -eq 0 ]; then
    # No config found, just create an empty session
    tmux new-session -d -s "$SESSION_NAME"
else
    # Put each window back at its saved index rather than packing them from the
    # base index. Gaps in the indices are normal (a window was closed), and
    # keeping them is what lets tmux-sync-tabs rebind these files by index after
    # a server restart, when every saved window id is stale.
    first_cwd="${TAB_CWD[0]}"
    if [ -n "$first_cwd" ] && [ -d "$first_cwd" ]; then
        tmux new-session -d -s "$SESSION_NAME" -n "${TAB_NAME[0]}" -c "$first_cwd"
    else
        tmux new-session -d -s "$SESSION_NAME" -n "${TAB_NAME[0]}"
    fi

    base_idx=$(tmux display-message -p -t "$SESSION_NAME" '#{window_index}')
    if [ "$base_idx" != "${TAB_INDEX[0]}" ]; then
        tmux move-window -s "$SESSION_NAME:$base_idx" -t "$SESSION_NAME:${TAB_INDEX[0]}" 2>/dev/null || true
    fi
    WIN_TARGET=("$(tmux display-message -p -t "$SESSION_NAME" '#{window_id}')")

    for i in "${!TAB_INDEX[@]}"; do
        [ "$i" -eq 0 ] && continue
        args=(-d -P -F '#{window_id}' -n "${TAB_NAME[$i]}")
        if [ -n "${TAB_CWD[$i]}" ] && [ -d "${TAB_CWD[$i]}" ]; then
            args+=(-c "${TAB_CWD[$i]}")
        fi
        # A saved index can be taken already if two sessions' files ended up in
        # one directory. Inserting after the previous window keeps the order and
        # loses only the exact index, which beats dropping the window.
        wid=$(tmux new-window "${args[@]}" -t "$SESSION_NAME:${TAB_INDEX[$i]}" 2>/dev/null) ||
            wid=$(tmux new-window "${args[@]}" -a -t "${WIN_TARGET[$((${#WIN_TARGET[@]} - 1))]}")
        WIN_TARGET+=("$wid")
    done

    # Bind the files to the windows that were just created, before anything
    # runs in them. The window ids and the server they came from are both new,
    # and until they are recorded every file still describes the dead server:
    # the Claude hook would find no file for the window it starts in and write
    # a second one, and the next reconcile would keep rebinding by index.
    # The hooks in tmux.conf fire on these windows too, but they can collide on
    # the lock and skip, so the one run that has to happen is done here.
    tmux run-shell "TMUX_SESSIONS_DIR=$(printf '%q' "$SESSIONS_DIR") $(printf '%q' "$SCRIPT_DIR/tmux-sync-tabs")" >/dev/null 2>&1 || true

    # Run the commands only once every window exists, and target windows by id:
    # an index can still shift while the session is being built.
    for i in "${!TAB_INDEX[@]}"; do
        if [ -n "${TAB_CMD[$i]}" ]; then
            tmux send-keys -t "${WIN_TARGET[$i]}" "${TAB_CMD[$i]}" Enter
        fi
    done
fi

# Attach to the session
tmux attach-session -t "$SESSION_NAME"
